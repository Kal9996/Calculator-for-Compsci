# The Definition of Addition that will get called when the user does the addition operation
# I will go into more depth here to keep the other functions more tidy
def addition():
    # This is the way that I choose how many inputs to use, so the user can add many numbers all at once
    addterms = int(input("choose the number of terms to add: "))
    # I set a variable equal to zero for better calculations later
    add = 0
    # if the number of terms that the user enters is less than 2, aka 1,0, or a negative number
    # This spits out that they must add more, as it is impossible to add together less than 2 numbers
    # Then it recalls the addition function
    if addterms < 2:
        print("Please enter a number greater than one")
        addition()
    # The loop that allows for multiple terms to be added, the "terms" variable, which was set earlier now ticks down each loop until it hits 0
    while addterms > 0:
        # The numbers that will be added
        Add = input("choose the number to add: ")
        # Makes sure that pi and square roots are calculated correctly
        Add = Add.replace("pi", "math.pi").replace("sqrt", "math.sqrt(")
        #converts the numbers to a usable format
        Add = float(eval(Add))
        # the variable "add", which turns into the final output, and is added to the variable "Add", which was just chosen
        # add starts at 0, labeled at line 11/12, and adds to each subsequent number
        add = Add + add
        # What causes the terms to tick down every loop
        addterms = addterms - 1

    # Once the amount of terms hits zero, it stops the loop and goes into this function
    if addterms == 0:
        # Prints the total of all the numbers
        print(f"The total sum of these numbers is {add}")
        # Asks the user if they would like to do another operation with the "cont" variable (continue)
        cont = input("Would you like to do another operation?").strip().lower()
        # If the user says any variation of yes, it recalls the "Operation" function
        if cont in ["yes", "y"]:
            Operation()

# The Definition of subtraction, using similar means to addition with some tweaks
