#Definition of standard deviation, similar to the basic operations, with a given amount of terms, and calculating their deviation
def StandardDeviation():
    SDterms = int(input("How many points are in your dataset: "))
    SDlist = []
    if SDterms < 2:
        print("There cannot be less than 2 points")
        StandardDeviation()
    else:
        while SDterms > 0:
            Item = input("Add a term: ").strip().lower().replace("pi", "math.pi").replace("sqrt", "math.sqrt(").replace("e", "math.e")
            Item = float(eval(Item))
            SDlist.append(Item)
            SDterms = SDterms - 1
        if SDterms == 0:
            SD = statistics.stdev(SDlist)
            print(f"The Standard Deviation is {SD}")
            cont = input("Would you like to do another operation?").strip().lower()
            if cont in ["yes", "y"]:
                Operation()

