#This is the definition of the master program that goes to each operation when the user inputs them. Using an input with certain keywords for each operation
def Operation():
    global Rad
    op = input("What operation would you like to do? ").strip().lower()
    # Basic formulaic operations
    if op in ["add", "addition"]:
        addition()
    elif op in ["sub", "subtraction"]:
        subtraction()
    elif op in ["mult", "multiplication"]:
        multiplication()
    elif op in ["div", "division"]:
        division()
    #Trigonometric operations
    elif op in ["sin", "s", "si"]:
        Sin()
    elif op in ["cos", "c", "co"]:
        Cos()
    elif op in ["tan", "t"]:
        Tan()
    elif op in ["arcsin", "asin"]:
        Arcsin()
    elif op in ["arccos", "acos"]:
        Arccos()
    elif op in ["arctan", "atan"]:
        Arctan()
    # Exponential and Logarithms
    elif op in ["exp", "exponentiation", "exponent"]:
        exponentiation()
    elif op in ["log"]:
        Log()
    elif op in ["ln"]:
        Ln()
    #Factorials
    elif op in ["factorial", "factorials", "fac", "fact"]:
        Factorial()
    # Standard Deviation and Statistics
    elif op in ["standard", "deviation", "sd", "standard deviation"]:
        StandardDeviation()
    elif op in ["average", "mean"]:
        Mean()
    #Setting the mode to degrees or Radians
    elif op in ["degrees", "degree"]:
        print("Mode set to degrees")
        Rad = "degrees"
        Operation()
    elif op in ["radians","rad"]:
        Rad = "radians"
        print("Mode set to radians")
        Operation()
    # A definitive end function
    elif op == "end":
        sys.exit()
    # The catchall if the user types in a different operation, or misspells an operation.
    else :
        print("This operation does not exist, please choose one that does")
        Operation()

#what actually runs the function, without this the whole program would simply be definitions.
Operation()



