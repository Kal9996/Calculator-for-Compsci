        # Also prevents the need to set the variable prior to the input
    if subterms > 0:
            Sub = input("choose the number to subtract: ")
            Sub = Sub.replace("pi", "math.pi").replace("sqrt", "math.sqrt(")
            Sub = float(eval(Sub))
            sub = Sub
            subterms = subterms - 1
        # The same loop as addition, and the main loop that runs every operation
    while subterms > 0:
            Sub = input("choose the number to subtract: ")
            Sub = Sub.replace("pi", "math.pi").replace("sqrt", "math.sqrt(")
            Sub = float(eval(Sub))
            sub = sub - Sub
            subterms = subterms - 1

    if subterms == 0:
        print(f"The difference of these  numbers is {sub}")
        cont = input("Would you like to do another operation?").strip().lower()
        if cont in ["yes", "y"]:
            Operation()

