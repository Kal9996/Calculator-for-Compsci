#definition of Tan, Has some changes outlined, but ends up being similar to other trig functions
def Tan():
    global Rad
    if Rad is None:
        Rad = input("Is the input in radians or degrees? ").strip().lower()
    if Rad in ["radians", "rad"]:
        Tana = input("(in Radians, Please add * when multiplying by pi) Tan(").strip().lower()
        TanA = Tana.replace("pi", "math.pi").replace("sqrt", "math.sqrt(")
        Radians = float(eval(TanA))
        TanB = math.tan(Radians)
        # Unlike the other trig functions, this one can end up being undefined because it divides by cos
        # This solves that issue by catching it if Cos=0 before it continues
        if math.isclose(math.cos(Radians), 0, abs_tol=1e-9):
            print(f"The result is undefined due to a divide by zero error")
        else:
            TanC = int(TanB * 10000) / 10000
            print(f"The Result is {TanC}")
        cont = input("Would you like to do another operation?").strip().lower()
        if cont in ["yes", "y"]:
            Operation()
    elif Rad in ["degrees", "deg", "degree"]:
        Tana = input("(in Degrees) Tan(")
        Tana = Tana.replace("pi", "math.pi").replace("sqrt", "math.sqrt(")
        Tana = float(eval(Tana))
        Radians = math.radians(Tana)
        TanB = math.tan(Radians)
        if math.isclose(math.cos(Radians), 0, abs_tol=1e-9):
            print(f"The result is undefined due to a divide by zero error")
        else:
            TanC = int(TanB * 10000) / 10000
            print(f"The Result is {TanC}")
        cont = input("Would you like to do another operation?").strip().lower()
        if cont in ["yes", "y"]:
            Operation()
    else:
        print("Input is neither Radians or Degrees")
        Tan()

