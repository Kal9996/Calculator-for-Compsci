#The Logarithm function
def Log():
    base = input("Choose the base for the Log: ").strip().lower()
    Base = base.replace("pi", "math.pi").replace("sqrt", "math.sqrt(").replace("e", "math.e")
    #Because log base e is Ln, catches the user input and sends to the Ln operation.
    if Base == "math.e":
        Ln()
    # due to these bases ending up as undefined answers, catches and redirects back to the base function
    else:
        Base = float(eval(base))
    if Base == 1 or Base == 0 or Base < 0:
        print("Log base cannot be given number")
        Operation()
    else:
        #calculates the log of a given number with a given base
        arg = input(f"Log{Base}( ").strip().lower()
        Arg = arg.replace("pi", "math.pi").replace("sqrt", "math.sqrt(").replace("e", "math.e")
        Arg = float(eval(Arg))
        Log = math.log(Arg, Base)
        print(f" Log{Base}({arg}) = {Log}")
        cont = input("Would you like to do another operation?").strip().lower()
        if cont in ["yes", "y"]:
            Operation()

#definition of Ln, same as log with slightly fewer steps
def Ln():
    arg = input("Ln(").strip().lower()
    Arg = arg.replace("pi", "math.pi").replace("sqrt", "math.sqrt(").replace("e", "math.e")
    Arg = float(eval(Arg))
    Ln = math.log(Arg)
    print(f" Ln({arg}) = {Ln}")
    cont = input("Would you like to do another operation?").strip().lower()
    if cont in ["yes", "y"]:
        Operation()

