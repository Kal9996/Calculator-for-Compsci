# The definition of Sin
def Sin():
    #Determines if the input will be in Radians or Degrees, which is important with Trig functions, but does not ask for it on repeated use due to the globalization of the Rad Variable
    global Rad
    if Rad is None:
        Rad = input("Is the input in radians or degrees? ").strip().lower()
        # if the function is in radians
    if Rad in ["radians", "rad"]:
        SinA = input("(in Radians) Sin(").strip().lower()
        SinA = SinA.replace("pi", "math.pi").replace("sqrt", "math.sqrt(")
        Radians = float(eval(SinA))
        # The actual function that calculates Sin
        SinB = math.sin(Radians)
        # Used to round the Sin function to 5 decimal places so that float point errors are nulled
        SinC = int(SinB * 10000) / 10000
        print(f"The Result is {SinC}")
        cont = input("Would you like to do another operation?").strip().lower()
        if cont in ["yes", "y"]:
            Operation()
        # if the function is in degrees, similar to above, with some unnecessary code removed
    elif Rad in ["degrees", "deg", "degree"]:
        Sina = input("(in Degrees) Sin(")
        Sina = Sina.replace("pi", "math.pi").replace("sqrt", "math.sqrt(")
        Sina = float(eval(Sina))
        Radians = math.radians(Sina)
        SinB = math.sin(Radians)
        SinC = int(SinB * 10000) / 10000
        print(f"The Result is {SinC}")
        cont = input("Would you like to do another operation?").strip().lower()
        if cont in ["yes", "y"]:
            Operation()
    else:
        print("Input is neither Radians or Degrees")
        Sin()

